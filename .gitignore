# Root layout (hard rule ARCH130): UnityProject/ Tools/ Dashboard/ Docs/ Template/ + AGENTS.md, CLAUDE.md, README.md

# Unity (generated inside UnityProject/)
/UnityProject/[Ll]ibrary/
/UnityProject/[Tt]emp/
/UnityProject/[Oo]bj/
/UnityProject/[Bb]uild/
/UnityProject/[Bb]uilds/
/UnityProject/[Ll]ogs/
/UnityProject/[Uu]ser[Ss]ettings/
/UnityProject/[Mm]emoryCaptures/
/UnityProject/[Rr]ecordings/
/UnityProject/Replays/
*.pidb.meta
*.pdb.meta
*.mdb.meta
sysinfo.txt
*.apk
*.aab
*.unitypackage
crashlytics-build.properties

# IDE / generated project files (Unity writes *.csproj and Core.slnx into UnityProject/)
.vs/
.idea/
*.csproj
*.sln
*.slnx
*.suo
*.user
*.userprefs
!Tools/LogicTests/LogicTests.csproj
!Tools/TestGate/TestGate.csproj
Tools/TestGate/bin/
Tools/TestGate/obj/
Tools/LogicTests/bin/
Tools/LogicTests/obj/
Tools/LogicTests/TestResults/

# Gate output read by the dashboard (Dashboard/ itself is the hand-written view)
/Dashboard/Data/

# Clean Core template: generated by Tools/make-template.sh, never committed
/Template/

# OS
.DS_Store
Thumbs.db

# Claude Code local settings
.claude/settings.local.json

# Agent Flight Recorder: event log + task (local; CI re-verifies)
/.agent/

# AI/human scratch work: outside UnityProject/ (Unity never imports it), never committed. `files clean --regenerable` empties it.
/.scratch/
.vscode/
