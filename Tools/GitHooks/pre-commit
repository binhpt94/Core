#!/usr/bin/env bash
# Blocks commits that break static architecture rules (same engine as CI/Unity). Works for every
# agent and human, including tools without Claude hooks. Install once: ./Tools/install-git-hooks.sh
set -euo pipefail
cd "$(dirname "$0")/../.."     # this file lives in <Root>/Tools/GitHooks/
exec ./Tools/test-gate.sh check --staged
