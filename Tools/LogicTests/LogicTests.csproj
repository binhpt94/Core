<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Runs every pure-C# assembly (Core, Features/*/Contracts, Features/*/Logic) and their tests
    WITHOUT Unity:  dotnet test LogicTests
    Source files are linked from Assets/, never copied. Unity-only folders (Unity/, Editor/, Core/Editor/, Bootstrap/, Tests/Unity/) are excluded.
    DevTools (fixtures, scenarios) are pure and compiled here, so every scenario is verified without Unity.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <!-- Unity 2022.3 / Unity 6 compile C# 9. Keep this in sync so AI cannot use newer syntax. -->
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>LogicTests</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <GameRoot>$(MSBuildThisFileDirectory)../Assets/_Game/</GameRoot>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(GameRoot)Core/**/*.cs" Exclude="$(GameRoot)Core/Editor/**/*.cs;$(GameRoot)Core/Unity/**/*.cs" />
    <Compile Include="$(GameRoot)Features/*/Contracts/**/*.cs" />
    <Compile Include="$(GameRoot)Features/*/Logic/**/*.cs" />
    <Compile Include="$(GameRoot)Features/*/DevTools/**/*.cs" />
    <Compile Include="$(GameRoot)Features/*/Tests/**/*.cs" Exclude="$(GameRoot)Features/*/Tests/Unity/**/*.cs" />
    <Compile Include="$(GameRoot)Tests/Architecture/**/*.cs" />
    <Compile Include="$(GameRoot)Architecture/Rules/**/*.cs" />
    <!-- Agent Flight Recorder (tools/TestGate/Agent): event log, scope policy, guards, reducer + their tests. -->
    <Compile Include="../tools/TestGate/Agent/*.cs" />
    <Compile Include="../tools/TestGate/Planning/*.cs" />
    <Compile Include="../tools/TestGate/Files/*.cs" />
    <Compile Include="AgentControl/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <!-- Unity Test Framework ships NUnit 3.5: only use APIs that exist there. -->
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
    <!-- Same version as Packages/manifest.json (com.cysharp.unitask). -->
    <PackageReference Include="UniTask" Version="2.5.10" />
  </ItemGroup>
</Project>
