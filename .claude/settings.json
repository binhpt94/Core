{
  "env": {
    "GAME_AGENT_SHELL": "claude"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/Tools/claude-hook.sh session",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write|NotebookEdit|Bash|Task|Agent|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/Tools/claude-hook.sh pre",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/Tools/claude-hook.sh post",
            "timeout": 60
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/Tools/claude-hook.sh subagent-stop",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/Tools/claude-hook.sh stop",
            "timeout": 600
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(dotnet test:*)",
      "Bash(dotnet build:*)",
      "Bash(./Tools/test-gate.sh:*)",
      "Bash(./Tools/run-tests.sh:*)",
      "Bash(./Tools/run-unity-tests.sh:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Edit(**/*.unity)",
      "Write(**/*.unity)",
      "Edit(**/*.prefab)",
      "Edit(**/*.meta)",
      "Bash(git commit --no-verify:*)",
      "Bash(git commit -n:*)",
      "Bash(git config core.hooksPath:*)",
      "Bash(git push --force:*)",
      "Bash(GOLDEN_WRITE=1 dotnet test:*)",
      "Bash(LAYOUT_WRITE=1:*)",
      "Bash(export LAYOUT_WRITE:*)",
      "Edit(**/Tests/Replays/**)",
      "Write(**/Tests/Replays/**)",
      "Edit(**/Tests/Layout/**)",
      "Write(**/Tests/Layout/**)",
      "Edit(.agent/**)",
      "Write(.agent/**)",
      "Bash(./Tools/test-gate.sh task approve:*)",
      "Bash(Tools/test-gate.sh task approve:*)",
      "Bash(./Tools/test-gate.sh roadmap accept:*)",
      "Bash(Tools/test-gate.sh roadmap accept:*)",
      "Bash(./Tools/test-gate.sh art accept:*)",
      "Bash(Tools/test-gate.sh art accept:*)",
      "Bash(./Tools/test-gate.sh files clean --regenerable --library:*)",
      "Read(Dashboard/Data/**)",
      "Read(.agent/**)"
    ]
  }
}
